{
  "name": "pokemon-team-status",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/download-sprites.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "preview:build": "vite build && vite preview --host",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "ci": "npm run check && npm run test:coverage",
    "check:staged": "biome check --write --no-errors-on-unmatched",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.43",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "lefthook": "^1.0.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "lefthook@1.13.6": true
  }
}
