{
  "name": "pokemon-team-status",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/download-sprites.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "preview:build": "vite build && vite preview --host",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check:staged": "biome check --write --no-errors-on-unmatched",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:duplication": "jscpd src/",
    "lint:sonar": "eslint --config eslint.config.sonar.mjs src/ scripts/",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.33",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jscpd": "^4.0.9",
    "lefthook": "^1.0.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "lefthook@1.13.6": true
  }
}
